{
  "name": "magnet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run generate-pages && tsc -b && vite build",
    "clear": "sh clear.sh",
    "generate-pages": "sh ./generate-pages.sh",
    "format:lint": "eslint . --fix",
    "format": "pnpm run \"/^format:.*/\"",
    "check:lint": "eslint .",
    "check": "pnpm run \"/^check:.*/\"",
    "preview": "vite preview",
    "prepare": "ts-patch install && typia patch",
    "deploy": "gh-pages -d dist -m \"deploy($(git rev-parse --abbrev-ref HEAD)): $(git rev-parse HEAD)\""
  },
  "dependencies": {
    "@unocss/reset": "^66.3.3",
    "chart.js": "^4.5.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "i18next": "^25.3.2",
    "react": "^19.1.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.0",
    "react-icons": "^5.5.0",
    "react-router": "^7.6.3",
    "typia": "^9.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@ryoppippi/unplugin-typia": "^2.6.5",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.31.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "ts-patch": "^3.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.18.2",
    "unocss": "^66.3.3",
    "vite": "^7.0.4"
  }
}
